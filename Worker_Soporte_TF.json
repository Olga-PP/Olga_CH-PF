    {
      "parameters": {
        "jsCode": "// Tarea atómica: validar que haya una descripción real antes de\n// crear el ticket (evita registros vacíos en Airtable).\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst fechaHoraSolicitud = trigger.fecha_hora_solicitud;\nconst descripcion = (trigger.descripcion_ticket || '').trim();\nconst mensajeOriginal = trigger.mensaje_original || '';\n\nif (!descripcion) {\n  return [{ json: { valido: false, motivo: 'descripcion_vacia', error_code: 'DESCRIPCION_VACIA', message: 'No se pudo extraer una descripción del problema.', retryable: true } }];\n}\n\nconst ticketId = 'TCK-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);\nconst idempotencyKey = trigger.empleado_ID + '_' + descripcion.toLowerCase().replace(/\\s+/g, '_').substring(0, 40);\n\nreturn [{\n  json: {\n    valido: true,\n    ticket_ID: ticketId,\n    empleado_ID: trigger.empleado_ID,\n    descripcion,\n    estado: 'abierto',\n    fecha_creacion: fechaHoraSolicitud,\n    mensaje_original: mensajeOriginal,\n    idempotency_key: idempotencyKey,\n    error_code: null,\n    message: 'Ticket creado correctamente.',\n    retryable: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -80,
        256
      ],
