      "name": "Es Consulta de Saldo"
    },
    {
      "parameters": {
        "jsCode": "// Desenlace 1: consulta pura. Igual se registra en Airtable para\n// dejar traza de la interacción, pero con estado \"consulta\" —\n// no es una solicitud real, no requiere aprobación de nadie.\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst esExcepcion = trigger.es_excepcion_a_politica === true;\nconst citaExcepcion = trigger.cita_politica_excepcion || '';\nconst mensajeOriginal = trigger.mensaje_original || '';\nconst idempotencyKey = trigger.empleado_ID + '_' + trigger.fecha_hora_solicitud;\nconst fechaHoraSolicitud = trigger.fecha_hora_solicitud;\nconst solicitudId = 'SOL-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);\n\nreturn [{\n  json: {\n    tipo: 'consulta',\n    solicitud_ID: solicitudId,\n    empleado_ID: trigger.empleado_ID,\n    dias_solicitados: 0,\n    dias_disponibles: Number(trigger.dias_disponibles) || 0,\n    estado: 'consulta',\n    fecha_solicitud: fechaHoraSolicitud,\n    token_aprobacion: '',\n    es_excepcion_a_politica: esExcepcion,\n    cita_politica_excepcion: citaExcepcion,\n    mensaje_original: mensajeOriginal,\n    idempotency_key: idempotencyKey,\n    error_code: null,\n    message: 'Consulta de saldo procesada correctamente.',\n    retryable: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        96
      ],
      "id": "59ddd9eb-3174-4af6-b877-fe6de38eedbd",
      "name": "Armar Consulta"
    },
    {
      "parameters": {
        "jsCode": "// El sistema NO rechaza vacaciones. Calcula la elegibilidad (alcanza / no alcanza)\n// y la deja como dato para la decisión humana. Siempre queda pendiente.\nconst trigger = $('Execute Workflow Trigger').first().json;\nconst esExcepcion = trigger.es_excepcion_a_politica === true;\nconst citaExcepcion = trigger.cita_politica_excepcion || '';\nconst mensajeOriginal = trigger.mensaje_original || '';\nconst idempotencyKey = trigger.empleado_ID + '_' + trigger.fecha_hora_solicitud;\nconst fechaHoraSolicitud = trigger.fecha_hora_solicitud;\nconst diasSolicitados = Number(trigger.dias_solicitados) || 0;\nconst diasDisponibles = Number(trigger.dias_disponibles) || 0;\nconst alcanza = (diasDisponibles - diasSolicitados) >= 0;\n\nconst solicitudId = 'SOL-' + Date.now() + '-' + Math.random().toString(36).substring(2, 8);\nconst tokenAprobacion = Math.random().toString(36).substring(2, 10) + Date.now().toString(36);\n\nreturn [{\n  json: {\n    tipo: 'solicitud_pendiente',\n    solicitud_ID: solicitudId,\n    empleado_ID: trigger.empleado_ID,\n    dias_solicitados: diasSolicitados,\n    dias_disponibles: diasDisponibles,\n    excede_saldo: !alcanza,\n    estado: 'pendiente',\n    token_aprobacion: tokenAprobacion,\n    fecha_solicitud: fechaHoraSolicitud,\n    es_excepcion_a_politica: esExcepcion,\n    cita_politica_excepcion: citaExcepcion,\n    mensaje_original: mensajeOriginal,\n    idempotency_key: idempotencyKey,\n    error_code: null,\n    message: alcanza\n      ? 'Solicitud registrada, pendiente de aprobación.'\n      : 'Solicitud registrada, pendiente de decisión de RRHH: el pedido excede el saldo disponible.',\n    retryable: false\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        608,
        400
      ],
